FROM sharelatex/sharelatex

# Override rate limiters to avoid blocking trusted users on small instances.
COPY overrides/PasswordResetRouter.mjs  /overleaf/services/web/app/src/Features/PasswordReset/PasswordResetRouter.mjs
COPY overrides/LoginRateLimiter.mjs     /overleaf/services/web/app/src/Features/Security/LoginRateLimiter.mjs
COPY overrides/OneTimeTokenHandler.mjs  /overleaf/services/web/app/src/Features/Security/OneTimeTokenHandler.mjs
